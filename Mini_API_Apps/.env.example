# Copy this file to .env and fill in your own key.
# Get one free at https://www.themoviedb.org/settings/api
#
# Note: EXPO_PUBLIC_ variables are inlined into the client bundle,
# so this key is visible to anyone who inspects the shipped app.
# That is acceptable for TMDB's public read-only search endpoints;
# never put a secret that must stay private behind this prefix.

EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
